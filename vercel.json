{
  "version": 2,
  "functions": {
    "api/goods.js": { "regions": ["icn1"] },
    "api/prefetch-goods.js": { "regions": ["icn1"] }
  },
  "crons": [],
  "headers": [
    {
      "source": "/goods/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=86400, stale-while-revalidate=3600" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/goods/(.*)", "destination": "/goods/$1" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/market", "destination": "/market.html" },
    { "source": "/(.*\\.(?:svg|png|jpg|jpeg|gif|webp|ico|css|js|woff|woff2|ttf))", "destination": "/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
